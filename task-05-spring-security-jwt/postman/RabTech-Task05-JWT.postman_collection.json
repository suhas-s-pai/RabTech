	"item": [
		{
			"name": "1. Register USER",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    pm.collectionVariables.set(\"token\", jsonData.token);",
							"    console.log(\"Saved USER token:\", jsonData.token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"suhas\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
				},
				"url": {
					"raw": "http://localhost:8081/api/auth/register",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"api",
						"auth",
						"register"
					]
				}
			},
			"response": []
